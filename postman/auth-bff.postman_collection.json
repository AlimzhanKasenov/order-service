    {
      "name": "04 - Login user 1",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('User 1 login returns 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const response = pm.response.json();",
              "",
              "pm.expect(response.tokenType).to.eql('Bearer');",
              "pm.expect(response.accessToken).to.be.a('string');",
              "pm.expect(response.accessToken).not.to.be.empty;",
              "",
              "pm.collectionVariables.set(",
              "    'token1',",
              "    response.accessToken",
              ");",
              "",
              "pm.test('Login user ID matches registered user', function () {",
              "    pm.expect(response.userId.toString()).to.eql(",
              "        pm.collectionVariables.get('user1Id')",
              "    );",
              "});"
            ]
          }
        }
      ],

      "request": {
        "method": "POST",

        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],

        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{user1Username}}\",\n  \"password\": \"{{user1Password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
