  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) {",
          "    const randomPart = Math.floor(Math.random() * 1000000);",
          "    const runId = Date.now().toString() + randomPart.toString();",
          "",
          "    pm.collectionVariables.set('runId', runId);",
          "",
          "    pm.collectionVariables.set(",
          "        'user1Username',",
          "        'user1_' + runId",
          "    );",
          "",
          "    pm.collectionVariables.set(",
          "        'user1Password',",
          "        'Password1_' + runId + '_A!'",
          "    );",
          "",
          "    pm.collectionVariables.set(",
          "        'user1Email',",
          "        'user1_' + runId + '@example.com'",
          "    );",
          "",
          "    pm.collectionVariables.set(",
          "        'user1UpdatedEmail',",
          "        'user1_updated_' + runId + '@example.com'",
          "    );",
          "",
          "    pm.collectionVariables.set(",
          "        'user2Username',",
          "        'user2_' + runId",
          "    );",
          "",
          "    pm.collectionVariables.set(",
          "        'user2Password',",
          "        'Password2_' + runId + '_B!'",
          "    );",
          "",
          "    pm.collectionVariables.set(",
          "        'user2Email',",
          "        'user2_' + runId + '@example.com'",
          "    );",
          "}"
        ]
      }
    },

    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "console.log('');",
          "console.log('================ REQUEST ================');",
          "console.log(",
          "    pm.request.method + ' ' +",
          "    pm.variables.replaceIn(pm.request.url.toString())",
          ");",
          "",
          "if (pm.request.body && pm.request.body.mode === 'raw') {",
          "    console.log(",
          "        pm.variables.replaceIn(pm.request.body.raw || '')",
          "    );",
          "}",
          "",
          "console.log('================ RESPONSE ===============');",
          "console.log('HTTP ' + pm.response.code);",
          "console.log(pm.response.text());",
          "console.log('=========================================');"
        ]
      }
    }
  ],

