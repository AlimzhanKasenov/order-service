  "item": [
    {
      "name": "01 - Register user 1",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('User 1 registration returns 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const response = pm.response.json();",
              "",
              "pm.expect(response.id).to.exist;",
              "",
              "pm.collectionVariables.set(",
              "    'user1Id',",
              "    response.id.toString()",
              ");",
              "",
              "pm.test('Registered username is correct', function () {",
              "    pm.expect(response.username).to.eql(",
              "        pm.collectionVariables.get('user1Username')",
              "    );",
              "});"
            ]
          }
        }
      ],

      "request": {
        "method": "POST",

        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],

        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{user1Username}}\",\n  \"password\": \"{{user1Password}}\",\n  \"firstName\": \"UserOne\",\n  \"lastName\": \"Initial\",\n  \"email\": \"{{user1Email}}\",\n  \"phone\": \"+77010000001\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },

        "url": {
          "raw": "{{baseUrl}}/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "register"
          ]
        }
      }
    },

