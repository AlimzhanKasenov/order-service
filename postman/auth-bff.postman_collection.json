              "});",
              "",
              "const response = pm.response.json();",
              "",
              "pm.test('Profile contains updated first name', function () {",
              "    pm.expect(response.firstName).to.eql(",
              "        'UserOneUpdated'",
              "    );",
              "});",
              "",
              "pm.test('Profile contains updated last name', function () {",
              "    pm.expect(response.lastName).to.eql(",
              "        'ProfileChanged'",
              "    );",
              "});",
              "",
              "pm.test('Profile contains updated email', function () {",
              "    pm.expect(response.email).to.eql(",
              "        pm.collectionVariables.get(",
              "            'user1UpdatedEmail'",
              "        )",
              "    );",
              "});"
            ]
          }
        }
      ],

