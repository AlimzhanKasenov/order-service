        "url": {
          "raw": "{{baseUrl}}/billing/accounts/{{userId}}/deposit",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "billing",
            "accounts",
            "{{userId}}",
            "deposit"
          ]
        }
      }
    },
