  "item": [
    {
      "name": "01 - Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Health returns 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const response = pm.response.json();",
              "",
              "pm.test('Health status is OK', function () {",
              "    pm.expect(response.status).to.eql('OK');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "02 - Register Saga user",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = Date.now().toString();",
              "",
              "pm.collectionVariables.set('runId', runId);",
              "pm.collectionVariables.set('username', 'saga' + runId);",
              "pm.collectionVariables.set(",
              "    'email',",
              "    'saga' + runId + '@example.com'",
              ");",
              "pm.collectionVariables.set('billingRetries', '0');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Registration returns 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const response = pm.response.json();",
              "",
              "pm.expect(response.id).to.exist;",
              "",
              "pm.collectionVariables.set(",
              "    'userId',",
              "    response.id.toString()",
              ");"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"Password12345\",\n  \"firstName\": \"Saga\",\n  \"lastName\": \"Kubernetes\",\n  \"email\": \"{{email}}\",\n  \"phone\": \"+77010000001\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "register"
          ]
        }
      }
    },
    {
      "name": "03 - Wait Billing account",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 404) {",
              "    const retries = Number(",
              "        pm.collectionVariables.get('billingRetries') || '0'",
              "    ) + 1;",
              "",
              "    pm.collectionVariables.set(",
              "        'billingRetries',",
              "        retries.toString()",
              "    );",
              "",
              "    if (retries < 10) {",
              "        pm.execution.setNextRequest(",
              "            '03 - Wait Billing account'",
              "        );",
              "    } else {",
              "        pm.test('Billing account created by Kafka', function () {",
              "            pm.expect.fail(",
              "                'Billing account was not created after 10 attempts'",
              "            );",
              "        });",
              "    }",
              "} else {",
              "    pm.test('Billing account returns 200', function () {",
              "        pm.response.to.have.status(200);",
              "    });",
              "",
              "    const response = pm.response.json();",
              "",
              "    pm.test('Initial balance is 0', function () {",
              "        pm.expect(response.balance).to.eql(0);",
              "    });",
              "",
              "    pm.collectionVariables.set('billingRetries', '0');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/billing/accounts/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "billing",
            "accounts",
            "{{userId}}"
          ]
        }
      }
    },
    {
      "name": "04 - Deposit 10000",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Deposit returns 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const response = pm.response.json();",
              "",
              "pm.test('Balance becomes 10000', function () {",
              "    pm.expect(response.balance).to.eql(10000);",
