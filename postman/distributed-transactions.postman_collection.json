    {
      "name": "06 - Saga success",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const slot = new Date(Date.now() + 86400000);",
              "slot.setUTCMilliseconds(0);",
              "pm.collectionVariables.set(\"deliverySlot\", slot.toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Successful Saga returns 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const response = pm.response.json();",
              "",
              "pm.test('Order status is CONFIRMED', function () {",
              "    pm.expect(response.status).to.eql('CONFIRMED');",
              "});",
              "",
              "pm.collectionVariables.set(",
              "    'successOrderId',",
              "    response.id.toString()",
              ");"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
