          "mode": "raw",
          "raw": "{\n  \"userId\": {{userId}},\n  \"price\": 3000,\n  \"productId\": 1,\n  \"quantity\": 1,\n  \"deliverySlot\": \"{{deliverySlot}}\"\n}",
