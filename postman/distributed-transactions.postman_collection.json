    {
      "name": "11 - Saga rollback on Delivery",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Failed Delivery Saga returns 409', function () {",
              "    pm.response.to.have.status(409);",
              "});",
              "",
              "const response = pm.response.json();",
              "",
              "pm.test('Order status is SAGA_FAILED', function () {",
              "    pm.expect(response.order.status).to.eql('SAGA_FAILED');",
              "});",
              "",
              "pm.test('Failure came from Delivery', function () {",
              "    pm.expect(response.message).to.include(",
              "        'delivery step failed'",
              "    );",
              "});",
              "",
              "pm.collectionVariables.set(",
              "    'failedOrderId',",
              "    response.order.id.toString()",
              ");"
            ]
          }
        }
