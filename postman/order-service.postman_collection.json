{
  "info": {
    "_postman_id": "0c7b8d1e-82cb-4aef-a577-4c6f4dba4db9",
    "name": "Order Service User CRUD",
    "description": "Проверка health-check и RESTful CRUD пользователей через arch.homework.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) {",
          "    pm.collectionVariables.set('runId', Date.now().toString());",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://arch.homework",
      "type": "string"
    },
    {
      "key": "runId",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Health status is OK', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.status).to.eql('OK');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Create user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"johndoe_{{runId}}\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"johndoe_{{runId}}@example.com\",\n  \"phone\": \"+71002003040\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/user",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "user"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Created user has id', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.id).to.be.a('number');",
              "    pm.collectionVariables.set('userId', body.id.toString());",
              "});",
              "",
              "pm.test('Created username is correct', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.username).to.eql('johndoe_' + pm.collectionVariables.get('runId'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Get user by id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/user/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "user",
            "{{userId}}"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Returned user id is correct', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.id.toString()).to.eql(pm.collectionVariables.get('userId'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Get all users",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/user",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "user"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Created user exists in list', function () {",
              "    const users = pm.response.json();",
              "    const userId = Number(pm.collectionVariables.get('userId'));",
              "    pm.expect(users.some(user => user.id === userId)).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Update user",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Julie\",\n  \"lastName\": \"Doe\",\n  \"email\": \"juliedoe_{{runId}}@example.com\",\n  \"phone\": \"+71004242424\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/user/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "user",
            "{{userId}}"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('User data was updated', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.firstName).to.eql('Julie');",
              "    pm.expect(body.phone).to.eql('+71004242424');",
              "    pm.expect(body.username).to.eql('johndoe_' + pm.collectionVariables.get('runId'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Get updated user",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/user/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "user",
            "{{userId}}"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Updated values were saved', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.firstName).to.eql('Julie');",
              "    pm.expect(body.email).to.eql('juliedoe_' + pm.collectionVariables.get('runId') + '@example.com');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Delete user",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/user/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "user",
            "{{userId}}"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 204', function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Verify user was deleted",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/user/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "user",
            "{{userId}}"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 404', function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "",
              "pm.test('Error message confirms deletion', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.message).to.eql('user not found');",
              "});",
              "",
              "pm.collectionVariables.unset('userId');",
              "pm.collectionVariables.unset('runId');"
            ]
          }
        }
      ]
    }
  ]
}
